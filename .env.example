# .env.example — copy to .env.local and fill in your values

# Neon / Supabase Postgres connection string
# Get this from your Neon dashboard → Connection Details → Prisma
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Your deployed app URL (no trailing slash)
# For local development this is http://localhost:3000
# On Vercel this is set automatically via VERCEL_URL (see next.config.js)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
